{
  "name": "skyvista",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.99.0",
    "lucide-react": "^0.577.0",
    "zod": "^4.3.6",
    "pdf-lib": "^1.17.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "@tailwindcss/postcss": "^4.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "tsx": "^4.21.0",
    "@playwright/test": "1.58.2",
    "prettier": "3.8.1"
  },
  "overrides": {
    "playwright": "https://registry.npmjs.org/playwright/-/playwright-1.58.2.tgz",
    "playwright-core": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.58.2.tgz"
  }
